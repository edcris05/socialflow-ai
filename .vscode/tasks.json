		{
			"label": "SocialFlow next flow",
			"type": "shell",
			"command": "php",
			"args": [
				"-r",
				"$f=file_get_contents('app-laravel/routes/web.php'); foreach (preg_match_all(\"/->name\\('([^']+)'\\)/\", $f, $m) ? $m[1] : [] as $name) echo $name, PHP_EOL;"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect brand knowledge",
			"type": "shell",
			"command": "ddev",
			"args": [
				"artisan",
				"tinker",
				"--execute=App\\Models\\Brand::query()->where(function ($q) { $q->where('name', 'ilike', '%Art Made%')->orWhere('slug', 'ilike', '%art%'); })->with('knowledgeEntries')->get(['id','name','slug'])->each(function ($brand) { echo json_encode(['brand' => $brand->only(['id','name','slug']), 'entries' => $brand->knowledgeEntries->map->only(['id','title','status','source'])->values()], JSON_UNESCAPED_UNICODE).PHP_EOL; });"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "List Art Made knowledge",
			"type": "shell",
			"command": "ddev",
			"args": [
				"psql",
				"-d",
				"socialflow_app",
				"-c",
				"SELECT b.id AS brand_id, b.name, b.slug, ke.id AS entry_id, ke.title, ke.status, ke.source FROM brands b LEFT JOIN knowledge_entries ke ON ke.brand_id = b.id WHERE b.name ILIKE '%Art Made%' OR b.slug ILIKE '%art%' ORDER BY b.name, ke.title;"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "List brands",
			"type": "shell",
			"command": "ddev",
			"args": [
				"psql",
				"-d",
				"socialflow_app",
				"-c",
				"SELECT id,name,slug FROM brands"
			],
			"isBackground": false,
			"problemMatcher": []
		},
