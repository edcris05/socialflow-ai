{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "SocialFlow migrate",
			"type": "shell",
			"command": "ddev",
			"args": [
				"artisan",
				"migrate",
				"--no-interaction"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "SocialFlow verify",
			"type": "shell",
			"command": "sh",
			"args": [
				"-lc",
				"ddev artisan migrate:status --no-interaction && ddev artisan test && curl -k -sS -o /dev/null -w 'HTTP %{http_code}\\n' https://socialflow-ai.ddev.site/marcas"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "SocialFlow HTTP check",
			"type": "shell",
			"command": "curl",
			"args": [
				"-k",
				"-sS",
				"-o",
				"/dev/null",
				"-w",
				"home HTTP %{http_code}\\n",
				"https://socialflow-ai.ddev.site/"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "SocialFlow guest check",
